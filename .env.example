# Copy to .env and replace every value. .env is gitignored: real
# credentials never go into this file or into git.

# --- App -----------------------------------------------------------------
APP_ENV=local
APP_PORT=8088

# --- WhatsApp Cloud API (Meta for Developers) ----------------------------
# Token you choose; Meta sends it back when verifying the webhook URL.
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-string
# App Secret: signs every webhook (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=replace-me
# Access token used to send messages through the Graph API.
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=000000000000000
# Graph API version, e.g. vNN.N. Check the current one in Meta's docs.
WHATSAPP_GRAPH_VERSION=vNN.N

# --- LLM (OpenAI-compatible Chat Completions format) ---------------------
# Requests go to {LLM_BASE_URL}/chat/completions. Provider: Anthropic.
# Any OpenAI-compatible provider works by changing these three values.
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=replace-me

# --- Database (MySQL service in compose.yaml) -----------------------------
DB_HOST=db
DB_PORT=3306
DB_HOST_PORT=3306
DB_DATABASE=bot
DB_TEST_DATABASE=bot_test
DB_USERNAME=bot
DB_PASSWORD=replace-me
DB_ROOT_PASSWORD=replace-me-too
